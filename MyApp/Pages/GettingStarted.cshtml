<section class="relative overflow-hidden bg-slate-950 border-t border-white/10">
    <div class="gs-drift absolute -top-24 right-1/4 h-96 w-96 rounded-full bg-indigo-600/20 blur-[120px] pointer-events-none"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Keep learning &mdash; and get unstuck</h2>
            <p class="mt-4 text-lg text-slate-400 max-w-2xl mx-auto">
                Working demos to read, releases to follow, and real people to ask when something doesn't behave.
            </p>
        </div>

        <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">

            @{
                void Tile(string href, string title, string blurb, string icon, string hoverCls, string iconCls, string textCls)
                {
                    <a href="@href" rel="noopener"
                       class="group flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 hover:bg-white/[0.07] transition-all hover:no-underline @hoverCls">
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg ring-1 ring-inset @iconCls">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">@Html.Raw(icon)</svg>
                        </div>
                        <h3 class="mt-4 text-base font-bold text-white">@title</h3>
                        <p class="mt-2 flex-1 text-sm text-slate-400 leading-relaxed">@blurb</p>
                        <span class="mt-4 inline-flex items-center text-sm font-semibold @textCls">
                            Open
                            <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.3 14.7a1 1 0 010-1.4L10.6 10L7.3 6.7a1 1 0 011.4-1.4l4 4a1 1 0 010 1.4l-4 4a1 1 0 01-1.4 0z" clip-rule="evenodd"/></svg>
                        </span>
                    </a>
                }

                Tile("https://github.com/NetCoreApps/LiveDemos", "Live Demos",
                    "Dozens of complete, running Apps with source - the fastest way to see an idea implemented end to end.",
                    "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\"/>",
                    "hover:border-sky-400/50", "bg-sky-500/15 text-sky-400 ring-sky-500/25", "text-sky-400");

                Tile("/whatsnew", "What's New",
                    "Every release, feature by feature, with the docs and demos that shipped alongside it.",
                    "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\"/>",
                    "hover:border-emerald-400/50", "bg-emerald-500/15 text-emerald-400 ring-emerald-500/25", "text-emerald-400");

                Tile("/posts/", "Blog & Videos",
                    "Deep dives, release walkthroughs and screencasts from the team building ServiceStack.",
                    "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z\"/>",
                    "hover:border-violet-400/50", "bg-violet-500/15 text-violet-400 ring-violet-500/25", "text-violet-400");

                Tile("/training", "Training",
                    "Structured, instructor-led training for teams that want to get productive quickly.",
                    "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 14l9-5-9-5-9 5 9 5z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 14l6.16-3.422A12.083 12.083 0 0118 15.5a12.083 12.083 0 01-6 1.5a12.083 12.083 0 01-6-1.5a12.083 12.083 0 01-.16-4.922L12 14z\"/>",
                    "hover:border-amber-400/50", "bg-amber-500/15 text-amber-400 ring-amber-500/25", "text-amber-400");
            }
        </div>

        <!-- Help strip -->
        <div class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-8 lg:flex lg:items-center lg:justify-between">
            <div class="max-w-2xl">
                <h3 class="text-xl font-bold text-white">Stuck on something?</h3>
                <p class="mt-2 text-slate-400 leading-relaxed">
                    Customers get prioritised support on the forums; everyone else is welcome on GitHub Discussions
                    and StackOverflow. Bugs and feature requests belong on the issue tracker.
                </p>
            </div>
            <div class="mt-6 lg:mt-0 lg:ml-8 flex flex-wrap gap-3">
