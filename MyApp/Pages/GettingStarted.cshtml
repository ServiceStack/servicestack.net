@page "/getting-started"
@attribute [RenderStatic]

@{
    ViewData["Title"] = "Getting Started";
    ViewData["Brand"] = "ServiceStack";

    // Single source of truth for the docs origin so every deep link stays consistent
    var docs = "https://docs.servicestack.net";
}

<style>
    /* Ambient hero glows - slow enough to read as atmosphere rather than motion */
    @@keyframes gs-drift {
        0%   { transform: translate3d(0,0,0) }
        50%  { transform: translate3d(24px,-18px,0) }
        100% { transform: translate3d(0,0,0) }
    }
    .gs-drift { animation: gs-drift 20s ease-in-out infinite }

    /* The quickstart spine: a vertical rule with a travelling pulse, so the 4 steps
       read as one continuous path instead of 4 unrelated cards. */
    .gs-spine { position: relative; overflow: hidden }
    .gs-spine::after {
        content: ""; position: absolute; inset: 0;
        background: linear-gradient(180deg, transparent, rgb(99 102 241 / .85), transparent);
        background-size: 100% 300%;
        animation: gs-pulse 5s linear infinite;
    }
    @@keyframes gs-pulse {
        from { background-position: 0 300% }
        to   { background-position: 0 -100% }
    }

    .gs-copied { color: rgb(52 211 153) !important }

    @@media (prefers-reduced-motion: reduce) {
        .gs-drift { animation: none !important }
        .gs-spine::after { animation: none; background: rgb(99 102 241 / .4) }
    }
</style>

<!-- ══════════════════════════════════════════════════════ HERO -->
<section class="relative w-full overflow-hidden bg-slate-950 border-b border-white/10">

    <div class="absolute inset-0 opacity-[0.16] pointer-events-none">
        <svg class="h-full w-full" aria-hidden="true">
            <defs>
                <pattern id="gs-grid" width="48" height="48" patternUnits="userSpaceOnUse">
                    <path d="M48 0H0V48" fill="none" stroke="#6366f1" stroke-width="1"/>
                </pattern>
                <radialGradient id="gs-fade" cx="50%" cy="0%" r="90%">
                    <stop offset="0%" stop-color="white" stop-opacity="1"/>
                    <stop offset="100%" stop-color="white" stop-opacity="0"/>
                </radialGradient>
                <mask id="gs-mask"><rect width="100%" height="100%" fill="url(#gs-fade)"/></mask>
            </defs>
            <rect width="100%" height="100%" fill="url(#gs-grid)" mask="url(#gs-mask)"/>
        </svg>
    </div>

    <div class="gs-drift absolute -top-32 left-1/4 h-[30rem] w-[30rem] rounded-full bg-indigo-600/25 blur-[130px] pointer-events-none"></div>
    <div class="gs-drift absolute top-32 right-1/5 h-[26rem] w-[26rem] rounded-full bg-sky-500/20 blur-[120px] pointer-events-none" style="animation-delay:-7s"></div>
    <div class="gs-drift absolute -bottom-20 left-1/3 h-80 w-80 rounded-full bg-emerald-500/10 blur-[110px] pointer-events-none" style="animation-delay:-13s"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14 pb-16 lg:pb-20">
        <div class="grid lg:grid-cols-[1fr_1fr] gap-12 lg:gap-16 items-center">

            <div>
                <div class="inline-flex items-center rounded-full border border-indigo-400/30 bg-indigo-500/10 px-3 py-1 text-sm font-medium text-indigo-200 backdrop-blur-xl">
                    <span class="flex h-2 w-2 rounded-full bg-emerald-400 mr-2 animate-pulse"></span>
                    New to ServiceStack? You're in the right place
                </div>

                <h1 class="mt-8 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.05]">
                    From zero to a<br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400">
                        working typed API
                    </span>
                </h1>

                <p class="mt-6 text-lg sm:text-xl text-slate-400 leading-relaxed max-w-xl">
                    One command scaffolds a .NET 10 project with Identity Auth, typed clients, AutoQuery CRUD
                    and built-in UIs already wired up. This page is the shortest path through it &mdash;
                    pick a starting point below, or take the four-step tour.
                </p>

                <div class="mt-8 max-w-md">
                    <div class="relative rounded-xl border border-white/10 bg-slate-900/80 backdrop-blur-sm px-4 py-3.5 font-mono text-sm text-slate-200 shadow-2xl">
                        <span class="select-none text-emerald-400 mr-2">$</span><span id="gs-hero-cmd">npx create-net web MyApp</span>
                        <button type="button" onclick="gsCopy('gs-hero-cmd', this)" aria-label="Copy command"
                                class="absolute right-2 top-1/2 -translate-y-1/2 rounded-lg p-2 text-slate-500 hover:text-white hover:bg-white/10 transition">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                            </svg>
                        </button>
                    </div>
                    <p class="mt-2 text-xs text-slate-500">Nothing to install. Requires the <a class="text-slate-400 underline decoration-slate-700 hover:text-white" href="https://dotnet.microsoft.com/download">.NET SDK</a>.</p>
                </div>

                <div class="mt-8 flex flex-wrap gap-4">
                    <a href="#quickstart" class="group inline-flex items-center justify-center rounded-lg bg-indigo-500 px-7 py-3.5 text-base font-bold text-white shadow-[0_0_30px_-8px_rgba(99,102,241,0.9)] hover:bg-indigo-400 transition-all hover:no-underline">
                        Take the 4-step tour
                        <svg class="ml-2 -mr-1 h-5 w-5 transition-transform group-hover:translate-y-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v9.586l3.293-3.293a1 1 0 111.414 1.414l-5 5a1 1 0 01-1.414 0l-5-5a1 1 0 111.414-1.414L9 13.586V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                    </a>
                    <a href="/start" class="inline-flex items-center justify-center rounded-lg border border-white/15 bg-white/5 px-7 py-3.5 text-base font-semibold text-slate-200 hover:bg-white/10 hover:text-white transition-all hover:no-underline">
                        Customize &amp; Download a project
                    </a>
                </div>
            </div>

            <!-- Right: the DTO -> API payoff, which is the idea everything else hangs off -->
            <div class="relative lg:ml-auto w-full">
                <div class="relative group">
                    <div class="absolute -inset-2 rounded-2xl bg-gradient-to-r from-indigo-500 via-sky-500 to-emerald-500 opacity-20 blur-2xl group-hover:opacity-40 transition duration-700"></div>

                    <div class="relative rounded-xl bg-slate-900 border border-slate-700/80 shadow-2xl overflow-hidden">
                        <div class="bg-slate-800/90 border-b border-slate-700 px-4 py-2.5 flex items-center gap-2">
                            <div class="flex gap-1.5">
                                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                                <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                            </div>
                            <div class="mx-auto text-xs font-mono text-slate-400">MyApp.ServiceModel/Hello.cs</div>
                        </div>
                        <pre class="px-5 py-4 text-[13px] leading-6 font-mono text-slate-300 overflow-x-auto"><code><span class="text-purple-400">public class</span> <span class="text-emerald-300">Hello</span> : <span class="text-emerald-300">IReturn</span>&lt;<span class="text-emerald-300">HelloResponse</span>&gt;
{
    <span class="text-purple-400">public required string</span> <span class="text-sky-300">Name</span> { <span class="text-purple-400">get</span>; <span class="text-purple-400">set</span>; }
}</code></pre>

                        <div class="border-t border-slate-800 bg-slate-950/60 px-5 py-3">
                            <p class="text-[11px] uppercase tracking-widest text-slate-500 font-semibold">That one DTO gives you</p>
                            <div class="mt-3 flex flex-wrap gap-2 text-xs font-mono">
                                <span class="rounded-md bg-indigo-500/10 border border-indigo-500/30 px-2 py-1 text-indigo-300">/api/Hello</span>
                                <span class="rounded-md bg-sky-500/10 border border-sky-500/30 px-2 py-1 text-sky-300">OpenAPI</span>
                                <span class="rounded-md bg-emerald-500/10 border border-emerald-500/30 px-2 py-1 text-emerald-300">Typed Clients</span>
                                <span class="rounded-md bg-amber-500/10 border border-amber-500/30 px-2 py-1 text-amber-300">API Explorer</span>
                                <span class="rounded-md bg-rose-500/10 border border-rose-500/30 px-2 py-1 text-rose-300">Validation</span>
                            </div>
                        </div>
                    </div>
                </div>

                <p class="mt-4 text-sm text-slate-500">
                    Read the walkthrough:
                    <a href="@docs/your-first-webservice-explained" class="text-slate-300 underline decoration-slate-700 hover:text-white">Your first WebService explained</a>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════ PICK A PATH -->
<section class="bg-white dark:bg-black">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-50">Where would you like to start?</h2>
            <p class="mt-4 text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
                Three ways in. They all end up in the same place &mdash; pick whichever matches how you like to learn.
            </p>
        </div>

        <div class="mt-14 grid md:grid-cols-3 gap-6">

            <!-- Build -->
            <div class="group relative flex flex-col rounded-2xl border border-gray-200 dark:border-gray-800 bg-gradient-to-b from-indigo-50/70 to-white dark:from-indigo-950/25 dark:to-black p-8 hover:border-indigo-400 hover:shadow-xl transition-all">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 ring-1 ring-inset ring-indigo-500/25">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <h3 class="mt-5 text-xl font-bold text-gray-900 dark:text-gray-50">Just let me build</h3>
                <p class="mt-2 text-gray-600 dark:text-gray-400 leading-relaxed">
                    Scaffold a production-ready project on your stack of choice and start writing APIs in the next five minutes.
                </p>
                <ul class="mt-6 space-y-2 text-sm">
                    <li><a href="/start" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline">Customize &amp; download a project &rarr;</a></li>
                    <li><a href="@docs/templates/" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline">Browse all project templates &rarr;</a></li>
                    <li><a href="/text-to-blazor" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline">Generate an App from a prompt &rarr;</a></li>
                </ul>
            </div>

            <!-- Understand -->
            <div class="group relative flex flex-col rounded-2xl border border-gray-200 dark:border-gray-800 bg-gradient-to-b from-sky-50/70 to-white dark:from-sky-950/25 dark:to-black p-8 hover:border-sky-400 hover:shadow-xl transition-all">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 ring-1 ring-inset ring-sky-500/25">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                </div>
                <h3 class="mt-5 text-xl font-bold text-gray-900 dark:text-gray-50">Show me how it works</h3>
                <p class="mt-2 text-gray-600 dark:text-gray-400 leading-relaxed">
                    Start from the message-based design that makes a single C# class into an API, typed client and UI.
                </p>
                <ul class="mt-6 space-y-2 text-sm">
                    <li><a href="@docs/create-your-first-webservice" class="text-sky-600 dark:text-sky-400 font-medium hover:underline">Create your first WebService &rarr;</a></li>
                    <li><a href="@docs/why-servicestack" class="text-sky-600 dark:text-sky-400 font-medium hover:underline">Why ServiceStack &rarr;</a></li>
                    <li><a href="@docs/architecture-overview" class="text-sky-600 dark:text-sky-400 font-medium hover:underline">Architecture overview &rarr;</a></li>
                </ul>
            </div>

            <!-- Existing systems -->
            <div class="group relative flex flex-col rounded-2xl border border-gray-200 dark:border-gray-800 bg-gradient-to-b from-emerald-50/70 to-white dark:from-emerald-950/25 dark:to-black p-8 hover:border-emerald-400 hover:shadow-xl transition-all">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 ring-1 ring-inset ring-emerald-500/25">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><ellipse cx="12" cy="6" rx="8" ry="3"/><path stroke-linecap="round" d="M4 6v12c0 1.657 3.582 3 8 3s8-1.343 8-3V6M4 12c0 1.657 3.582 3 8 3s8-1.343 8-3"/></svg>
                </div>
                <h3 class="mt-5 text-xl font-bold text-gray-900 dark:text-gray-50">I already have a database</h3>
                <p class="mt-2 text-gray-600 dark:text-gray-400 leading-relaxed">
                    Point ServiceStack at an existing RDBMS and get typed CRUD APIs plus an instant admin UI generated for you.
                </p>
                <ul class="mt-6 space-y-2 text-sm">
                    <li><a href="@docs/autoquery/autogen" class="text-emerald-600 dark:text-emerald-400 font-medium hover:underline">AutoQuery CRUD from your DB &rarr;</a></li>
                    <li><a href="/locode" class="text-emerald-600 dark:text-emerald-400 font-medium hover:underline">Instant Locode admin UI &rarr;</a></li>
                    <li><a href="@docs/servicify" class="text-emerald-600 dark:text-emerald-400 font-medium hover:underline">Servicify existing systems &rarr;</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════ QUICKSTART -->
<section id="quickstart" class="scroll-mt-20 relative border-y border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950/60">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center">
            <p class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">The 4-step tour</p>
            <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-50">Your first API, end to end</h2>
            <p class="mt-4 text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
                Follows the docs' <a href="@docs/create-your-first-webservice" class="text-indigo-600 dark:text-indigo-400 hover:underline">Create your first WebService</a> walkthrough.
                Each step links to the reference if you want to go deeper.
            </p>
        </div>

        <ol class="mt-14 space-y-0">

            @{
                void Step(int n, string title, string blurb, string cmd, string cmdId, string linkText, string href, bool last = false)
                {
                    <li class="relative grid grid-cols-[3rem_1fr] sm:grid-cols-[4rem_1fr] gap-x-4 sm:gap-x-6">
                        <div class="relative flex flex-col items-center">
                            <div class="relative z-10 flex h-12 w-12 flex-none items-center justify-center rounded-full bg-white dark:bg-gray-900 border-2 border-indigo-500 text-lg font-extrabold text-indigo-600 dark:text-indigo-400 shadow-sm">
                                @n
                            </div>
                            @if (!last)
                            {
                                <div class="gs-spine w-px flex-1 bg-indigo-200 dark:bg-indigo-900"></div>
                            }
                        </div>
                        <div class="@(last ? "pb-0" : "pb-12")">
                            <h3 class="text-xl font-bold text-gray-900 dark:text-gray-50 leading-none pt-3">@title</h3>
                            <p class="mt-3 text-gray-600 dark:text-gray-400 leading-relaxed">@Html.Raw(blurb)</p>
                            @if (cmd != null)
                            {
                                <div class="mt-4 relative rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-slate-900 px-4 py-3 font-mono text-sm text-gray-800 dark:text-slate-200 shadow-sm">
                                    <span class="select-none text-emerald-500 mr-2">$</span><span id="@cmdId">@cmd</span>
                                    <button type="button" onclick="gsCopy('@cmdId', this)" aria-label="Copy command"
                                            class="absolute right-2 top-1/2 -translate-y-1/2 rounded-lg p-2 text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                        </svg>
                                    </button>
                                </div>
                            }
                            <a href="@href" class="mt-4 inline-flex items-center text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
                                @linkText
                                <svg class="ml-1 h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.3 14.7a1 1 0 010-1.4L10.6 10L7.3 6.7a1 1 0 011.4-1.4l4 4a1 1 0 010 1.4l-4 4a1 1 0 01-1.4 0z" clip-rule="evenodd"/></svg>
                            </a>
                        </div>
                    </li>
                }

                Step(1, "Create your project",
                    "One command scaffolds a complete .NET 10 App. <code class=\"px-1 rounded bg-gray-200 dark:bg-gray-800 text-[13px]\">web</code> is the Empty template &mdash; swap it for <code class=\"px-1 rounded bg-gray-200 dark:bg-gray-800 text-[13px]\">react-spa</code>, <code class=\"px-1 rounded bg-gray-200 dark:bg-gray-800 text-[13px]\">vue-mjs</code>, <code class=\"px-1 rounded bg-gray-200 dark:bg-gray-800 text-[13px]\">blazor</code> or any other template name.",
                    "npx create-net web MyApp", "gs-cmd-1",
                    "Browse every template", docs + "/templates/");

                Step(2, "Run a watched build",
                    "Press <b>Ctrl+F5</b> in your IDE, or run a watched build from the terminal so your App rebuilds and restarts on every save.",
                    "dotnet watch", "gs-cmd-2",
                    "Project structure explained", docs + "/physical-project-structure");

                Step(3, "Call your API",
                    "Your project already exposes a working API from a single Request DTO. Browse and call it from the built-in <b>API Explorer</b> at <code class=\"px-1 rounded bg-gray-200 dark:bg-gray-800 text-[13px]\">/ui</code>, or hit it from the command line.",
                    "x send https://localhost:5001 Hello {\"name\":\"World\"}", "gs-cmd-3",
                    "API Explorer docs", docs + "/api-explorer");

                Step(4, "Consume it from your client",
                    "Generate typed DTOs for your front-end &mdash; C#, TypeScript, Dart, Kotlin, Swift, Python and more &mdash; so your client stays in sync with your API automatically.",
                    "npx get-dtos typescript https://localhost:5001", "gs-cmd-4",
                    "Add ServiceStack Reference", docs + "/add-servicestack-reference-overview", last: true);
            }
        </ol>

        <div class="mt-14 rounded-2xl border border-indigo-200 dark:border-indigo-900/60 bg-indigo-50/60 dark:bg-indigo-950/20 px-6 py-5 sm:flex sm:items-center sm:justify-between">
            <div>
                <p class="font-semibold text-gray-900 dark:text-gray-50">Prefer the full narrated version?</p>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">The docs walk through each file the template generates and why it's there.</p>
            </div>
            <a href="@docs/your-first-webservice-explained" class="mt-4 sm:mt-0 sm:ml-6 inline-flex flex-none items-center justify-center rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 hover:no-underline transition">
                Your first WebService explained
            </a>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════ BATTERIES INCLUDED -->
<section class="bg-white dark:bg-black">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-50">What you get without writing any UI</h2>
            <p class="mt-4 text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
                Every ServiceStack App ships with these built in. They read your APIs' metadata, so they light up
                the moment you add a DTO &mdash; no configuration, no extra packages.
            </p>
        </div>

        <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

            @{
                void Card(string href, string img, string alt, string kicker, string title, string blurb, string hoverCls, string textCls)
                {
                    <a href="@href" class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 hover:shadow-xl transition-all hover:no-underline @hoverCls">
                        <div class="relative aspect-[16/10] overflow-hidden bg-gray-100 dark:bg-gray-900">
                            <img src="@img" alt="@alt" loading="lazy"
                                 class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.04]"/>
                        </div>
                        <div class="flex flex-1 flex-col p-6">
                            <p class="text-xs font-bold uppercase tracking-widest @textCls">@kicker</p>
                            <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-gray-50">@title</h3>
                            <p class="mt-2 flex-1 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">@blurb</p>
                            <span class="mt-4 inline-flex items-center text-sm font-semibold @textCls">
                                Learn more
                                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.3 14.7a1 1 0 010-1.4L10.6 10L7.3 6.7a1 1 0 011.4-1.4l4 4a1 1 0 010 1.4l-4 4a1 1 0 01-1.4 0z" clip-rule="evenodd"/></svg>
                            </span>
                        </div>
                    </a>
                }

                Card("/auto-ui", "/img/pages/admin-ui/carousel/api-explorer.webp", "API Explorer",
                    "/ui", "API Explorer", "A generated UI for every API in your App - call them, inspect responses and copy working client code in 10+ languages.",
                    "hover:border-sky-400", "text-sky-600 dark:text-sky-400");

                Card("/locode", "/img/pages/locode/northwind/screenshot.png", "Locode",
