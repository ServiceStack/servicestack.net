@page "/"
@attribute [RenderStatic]
@inject MarkdownBlog Blog
@inject MarkdownVideos Videos
@{
    ViewData["Title"] = "ServiceStack";

    var videoGroups = new (string Id, string Title, string Summary, string? LearnMore, string[] Groups)[]
    {
        ("apis",       "ServiceStack APIs", "Effortlessly create feature-rich APIs and Web Apps", null,
            new[]{ "apis" }),
        ("templates",  "Project Templates", "Get started quickly with your preferred stack", "https://docs.servicestack.net/templates/",
            new[]{ "projects", "vue-projects" }),
        ("blazor",     "Blazor",            "Beautiful, modern, productive Blazor Tailwind templates", "/blazor",
            new[]{ "blazor" }),
        ("vue",        "Vue",               "Vue Vite templates and Tailwind Vue components", "/vue/",
            new[]{ "vue" }),
        ("flutter",    "Flutter",           "Build Flutter Apps against your typed ServiceStack APIs", "/flutter",
            new[]{ "flutter", "flutter-grpc" }),
        ("autoquery",  "AutoQuery",         "Instant queryable & CRUD APIs over your data", "/autoquery",
            new[]{ "autoquery", "autogen" }),
        ("uis",        "Built-in UIs",      "Admin UIs, API Explorer and Locode in every App", "/auto-ui",
            new[]{ "ui-admin", "ui-explorer", "ui-locode", "ui-jobs", "ui-autohtml" }),
        ("mobile",     "Mobile Apps",       "Native typed integrations for all popular mobile languages", "https://docs.servicestack.net/clients-overview",
            new[]{ "mobile" }),
        ("dtos",       "Typed DTOs",        "End-to-end typed APIs that integrate with any platform", "https://docs.servicestack.net/add-servicestack-reference",
            new[]{ "ss-ref", "node" }),
        ("ai",         "AI",                "AI Chat, unified LLM APIs, Ollama, ComfyUI & FFmpeg", "/ai",
            new[]{ "ai", "ai-server" }),
        ("grpc",       "gRPC",              "Your typed Services, available over gRPC HTTP/2", "https://docs.servicestack.net/grpc",
            new[]{ "grpc" }),
        ("actions",    "Deployments",       "GitHub Actions templates for a variety of deployments", "https://docs.servicestack.net/github-action-templates",
            new[]{ "actions" }),
        ("jupyter",    "Jupyter",           "Interactive computing notebooks over your APIs", "https://docs.servicestack.net/jupyter-notebooks",
            new[]{ "jupyter" }),
        ("features",   "More Features",     "Other exciting features in the ServiceStack ecosystem", "/features",
            new[]{ "features" }),
        ("creatorkit", "CreatorKit",        "Self-hosted alternative to Mailchimp and Disqus", "/creatorkit/",
            new[]{ "creatorkit" }),
    };
    var activeGroup = videoGroups[0].Id;
}

@section head {
  <link rel="preload" href="/img/pages/index/dashboard.webp" as="image">
  <link rel="preload" href="/img/pages/index/analytics.webp" as="image">
  <link rel="preload" href="/img/pages/index/users.webp" as="image">
  <link rel="preload" href="/img/pages/index/roles.webp" as="image">
  <link rel="preload" href="/img/pages/index/apikeys.webp" as="image">
  <link rel="preload" href="/img/pages/index/logging.webp" as="image">
  <link rel="preload" href="/img/pages/index/profiling.webp" as="image">
  <link rel="preload" href="/img/pages/index/commands.webp" as="image">
  <link rel="preload" href="/img/pages/index/backgroundjobs.webp" as="image">
  <link rel="preload" href="/img/pages/index/validation.webp" as="image">
  <link rel="preload" href="/img/pages/index/database.webp" as="image">
  <link rel="preload" href="/img/pages/index/redis.webp" as="image">
  <style>
    @@keyframes ss-drift {
        0%   { transform: translate3d(0,0,0) }
        50%  { transform: translate3d(24px,-24px,0) }
        100% { transform: translate3d(0,0,0) }
    }
    .ss-drift { animation: ss-drift 20s ease-in-out infinite }
    @@media (prefers-reduced-motion: reduce) { .ss-drift { animation: none !important } }
  </style>
}

<!-- ============================================================ HERO -->
<section class="relative isolate overflow-hidden bg-gray-900">
  <svg class="absolute inset-0 -z-10 h-full w-full stroke-white/10 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
    <defs>
      <pattern id="hero-grid" width="200" height="200" x="50%" y="-1" patternUnits="userSpaceOnUse">
        <path d="M.5 200V.5H200" fill="none" />
      </pattern>
    </defs>
    <svg x="50%" y="-1" class="overflow-visible fill-gray-800/20">
      <path d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z" stroke-width="0" />
    </svg>
    <rect width="100%" height="100%" stroke-width="0" fill="url(#hero-grid)" />
  </svg>
  <div class="ss-drift absolute -top-24 left-1/4 -z-10 h-[32rem] w-[32rem] rounded-full bg-indigo-600/20 blur-[130px]"></div>
  <div class="ss-drift absolute top-1/3 right-1/4 -z-10 h-[28rem] w-[28rem] rounded-full bg-sky-500/20 blur-[130px]" style="animation-delay:-7s"></div>

  <div class="mx-auto max-w-7xl px-6 pt-10 pb-20 lg:flex lg:pt-24 lg:pb-32 lg:px-8">
    <div class="mx-auto max-w-2xl flex-shrink-0 lg:mx-0 lg:max-w-xl lg:pt-8">
      <a href="./"><svg class="h-16 w-16 text-indigo-500" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><path fill="currentColor" d="M10 6c1.544 1.76 2.276 4.15 2.217 6.61c3.968 1.67 9.924 6.12 11.181 12.39H28C26.051 14.31 14.918 6.77 10 6zm-2 7c4.67 4.913.81 11.582-4 12h18.97C21.5 18.289 11.95 13.533 8 13z"/></svg></a>

      <div class="mt-16 sm:mt-20 lg:mt-12">
        <a href="whatsnew" class="inline-flex items-center space-x-4 group">
          <span class="rounded-full bg-indigo-500/10 px-3 py-1 text-sm font-semibold leading-6 text-indigo-300 ring-1 ring-inset ring-indigo-500/20">What's new</span>
          <span class="inline-flex items-center space-x-2 text-sm font-medium leading-6 text-gray-300">
            <span>v10.1 - 15 languages, AI Chat, Schemas &amp; PDF</span>
            <svg class="h-5 w-5 text-gray-500 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          </span>
        </a>
      </div>

      <h1 class="mt-8 text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Simplicity at Speed
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-300">
        One framework to power them all. Write your HTTP APIs once and get end-to-end typed
        integrations for <b class="text-white">15 languages</b>, instant Admin UIs, queryable data APIs
        and safe AI capabilities - all generated from the same typed Request DTOs.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="start" class="rounded-md bg-indigo-500 px-5 py-3 text-lg font-semibold text-white shadow-sm hover:bg-indigo-400">Get ServiceStack</a>
        <a href="https://docs.servicestack.net/why-servicestack" class="rounded-md border border-white/15 bg-white/5 px-5 py-3 text-lg font-semibold text-white hover:bg-white/10">Why ServiceStack?</a>
      </div>

      <dl class="mt-12 grid grid-cols-3 gap-4 border-t border-white/10 pt-8">
        <div>
          <dt class="text-2xl font-extrabold text-white">15</dt>
          <dd class="mt-1 text-sm text-gray-400">Typed client languages</dd>
        </div>
        <div>
          <dt class="text-2xl font-extrabold text-white">12+</dt>
          <dd class="mt-1 text-sm text-gray-400">Built-in Admin UIs</dd>
        </div>
        <div>
          <dt class="text-2xl font-extrabold text-white whitespace-nowrap">.NET &vert; Framework</dt>
          <dd class="mt-1 text-sm text-gray-400 whitespace-nowrap">Runs everywhere .NET does</dd>
        </div>
      </dl>
    </div>

    <div class="mx-auto mt-16 flex max-w-2xl sm:mt-24 lg:ml-10 lg:mt-0 lg:mr-0 lg:max-w-none lg:flex-none xl:ml-32">
      <div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
        <img src="/img/pages/index/dark-and-light-mode.png" alt="ServiceStack App screenshot" width="2432" height="1442" class="w-[76rem] rounded-md bg-white/5 shadow-2xl ring-1 ring-white/10">
      </div>
    </div>
  </div>
  @await Html.PartialAsync("StartLinks")
</section>

@await Html.PartialAsync("PrimaryNav", "./")

<!-- ============================================================ FROM THE BLOG -->
<section class="border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-3xl">Latest from the blog</h2>
        <p class="mt-2 text-lg leading-8 text-gray-600 dark:text-gray-400">Release announcements, deep dives and tutorials</p>
      </div>
      <a href="/posts/" class="inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 dark:text-indigo-400">All posts <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-3">
      @foreach (var post in Blog.VisiblePosts.OrderByDescending(x => x.Date).Take(3))
      {
        <a href="@Blog.GetPostLink(post)" class="group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg hover:no-underline dark:border-gray-800 dark:bg-black">
          <div class="aspect-video overflow-hidden bg-gray-100 dark:bg-gray-900">
            <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="@Blog.GetSplashImage(post)" alt="">
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="text-lg font-semibold leading-6 text-gray-900 dark:text-gray-100">@post.Title</p>
            <p class="mt-2 line-clamp-3 text-sm text-gray-600 dark:text-gray-400">@post.Summary</p>
            @if (post.Date != null)
            {
              <time class="mt-auto pt-4 text-xs text-gray-500" datetime="@($"{post.Date.Value:yyyy-MM-dd}")">@($"{post.Date.Value:MMMM d, yyyy}")</time>
            }
          </div>
        </a>
      }
    </div>
  </div>
</section>

<!-- ============================================================ CORE PILLARS -->
<section class="bg-white dark:bg-black py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base font-semibold leading-7 text-indigo-600">Everything from one API contract</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl">
        Declare your APIs once, the rest is Free.
      </p>
      <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
        Your typed Request DTOs are the single source of truth - every client, UI, schema
        and AI capability below is generated from them, and stays in sync automatically.
      </p>
    </div>

    <div id="dto-deck" class="mt-12"></div>

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">

      <a href="https://docs.servicestack.net/add-servicestack-reference" class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 p-7 transition-all hover:-translate-y-1 hover:border-indigo-400 hover:shadow-xl hover:no-underline">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-gray-100">Typed APIs in 15 Languages</h3>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Native DTOs and a feature-rich Service Client for C#, TypeScript, Python, Go, Rust, Ruby,
          Zig, Swift, Kotlin, Dart and more - no hand-written SDKs.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 dark:text-indigo-400">Add ServiceStack Reference <span aria-hidden="true">&rarr;</span></span>
      </a>

      <a href="autoquery" class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 p-7 transition-all hover:-translate-y-1 hover:border-sky-400 hover:shadow-xl hover:no-underline">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 3.6 3 8 3s8-1 8-3V7M4 7c0 2 3.6 3 8 3s8-1 8-3M4 7c0-2 3.6-3 8-3s8 1 8 3m0 5c0 2-3.6 3-8 3s-8-1-8-3"/></svg>
        </div>
        <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-gray-100">AutoQuery</h3>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          One line of C# gives you a fully queryable, paged, filterable and authorized Query &amp; CRUD
          API over your RDBMS - then renders its own admin UI.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-sky-600 dark:text-sky-400">Explore AutoQuery <span aria-hidden="true">&rarr;</span></span>
      </a>

      <a href="auto-ui" class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 p-7 transition-all hover:-translate-y-1 hover:border-violet-400 hover:shadow-xl hover:no-underline">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 dark:bg-violet-950/60 text-violet-600 dark:text-violet-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM4 10h16M9 10v10"/></svg>
        </div>
        <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-gray-100">Built-in UIs</h3>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          A suite of Admin UIs, API Explorer and Locode in every App - users, roles, API keys,
          logging, profiling, background jobs, analytics and database browsing.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600 dark:text-violet-400">See the Built-in UIs <span aria-hidden="true">&rarr;</span></span>
      </a>

      <a href="https://docs.servicestack.net/chat/" class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 p-7 transition-all hover:-translate-y-1 hover:border-emerald-400 hover:shadow-xl hover:no-underline">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.42-4.03 8-9 8a9.9 9.9 0 01-4-.8L3 21l1.3-3.9A7.6 7.6 0 013 12c0-4.42 4.03-8 9-8s9 3.58 9 8z"/></svg>
        </div>
        <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-gray-100">AI Chat &amp; API Tools</h3>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          A complete AI application inside your App, with your existing users - and your own
          APIs safely exposed as AI capabilities behind human approval.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 dark:text-emerald-400">Discover AI Chat <span aria-hidden="true">&rarr;</span></span>
