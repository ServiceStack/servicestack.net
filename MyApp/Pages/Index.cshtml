<section id="videos" class="scroll-mt-20 border-y border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl">Watch &amp; Learn</h2>
      <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-gray-400">
        Short, focused walkthroughs covering everything from your first API to deployments.
      </p>
    </div>

    <!-- Tab bar -->
    <div class="mt-12 flex flex-wrap justify-center gap-2">
      @foreach (var g in videoGroups)
      {
        var count = g.Groups.Sum(x => Videos.GetVideos(x).Count);
        if (count == 0) continue;
        <button type="button" data-vtab="@g.Id" onclick="ssVideoTab('@g.Id')"
                class="ss-vtab inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition">
          @g.Title
          <span class="rounded-full bg-black/5 px-1.5 text-xs dark:bg-white/10">@count</span>
        </button>
      }
    </div>

    <!-- Panels -->
    @foreach (var g in videoGroups)
    {
      var videos = g.Groups.SelectMany(x => Videos.GetVideos(x)).ToList();
      if (videos.Count == 0) continue;
      <div data-vpanel="@g.Id" class="ss-vpanel mt-10 @(g.Id == activeGroup ? "" : "hidden")">
        <div class="mx-auto max-w-3xl text-center">
          <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">@g.Title</h3>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            @g.Summary
            @if (g.LearnMore != null)
            {
              <a href="@g.LearnMore" class="ml-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400">Learn more <span aria-hidden="true">&rarr;</span></a>
            }
          </p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          @foreach (var video in videos)
          {
            var videoId = video.Url.LastRightPart('/');
            <article class="group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-800">
              <lite-youtube width="560" height="315" videoid="@videoId" class="block w-full"
                            style="background-image: url('https://img.youtube.com/vi/@videoId/hqdefault.jpg')"></lite-youtube>
              <div class="flex flex-1 flex-col bg-slate-800 p-4 dark:bg-slate-900">
                <h4 class="text-base font-semibold leading-6 text-white">
                  <a href="@video.Url" class="transition-colors hover:text-indigo-300">@video.Title</a>
                </h4>
                <div class="mt-auto flex flex-wrap items-center gap-2 pt-3 text-xs text-slate-400">
                  @if (video.Date != null)
                  {
                    <time datetime="@($"{video.Date.Value:yyyy-MM-dd}")">@($"{video.Date.Value:MMMM d, yyyy}")</time>
                  }
                  @foreach (var tag in video.Tags.Safe().Take(2))
                  {
                    <span class="rounded-full bg-white/10 px-2 py-0.5 font-medium text-slate-300">@tag</span>
                  }
                </div>
              </div>
            </article>
          }
        </div>
      </div>
    }
  </div>
</section>

<script>
const SS_VTAB_ON  = 'border-indigo-500 bg-indigo-50 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300'
const SS_VTAB_OFF = 'border-gray-200 dark:border-gray-800 bg-white dark:bg-black text-gray-600 dark:text-gray-400 hover:border-indigo-300'
function ssVideoTab(id) {
    document.querySelectorAll('.ss-vtab').forEach(b => {
        const on = b.dataset.vtab === id
        b.className = 'ss-vtab inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition ' + (on ? SS_VTAB_ON : SS_VTAB_OFF)
    })
    document.querySelectorAll('.ss-vpanel').forEach(p => p.classList.toggle('hidden', p.dataset.vpanel !== id))
}
ssVideoTab('@activeGroup')
</script>

