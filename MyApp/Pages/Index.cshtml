<script>
;(function () {
    const shots   = Array.from(document.querySelectorAll('.ai-shot'))
    const thumbs  = Array.from(document.querySelectorAll('.ai-thumb'))
    const caption = document.getElementById('ai-gallery-caption')
    const url     = document.getElementById('ai-gallery-url')
    const root    = document.getElementById('ai-gallery')
    const strip   = document.getElementById('ai-gallery-strip')
    if (shots.length < 2) return

    const BASE = 'ai-thumb h-20 w-28 shrink-0 overflow-hidden rounded-lg border-2 transition-all duration-300 [&>img]:h-full [&>img]:w-full'
    const ON   = BASE + ' z-[1] scale-105 border-emerald-400 opacity-100 shadow-lg shadow-emerald-500/40 ring-2 ring-emerald-400/30'
    const OFF  = BASE + ' scale-95 border-white/10 opacity-40 saturate-50 hover:scale-100 hover:border-white/30 hover:opacity-90 hover:saturate-100'
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let i = 0, timer = null, paused = reduced, visible = true

    function render() {
        shots.forEach((s, n) => s.style.opacity = n === i ? '1' : '0')
        thumbs.forEach((t, n) => t.className = n === i ? ON : OFF)
        if (caption) caption.textContent = shots[i].dataset.caption || ''
        if (url) url.textContent = shots[i].dataset.url || ''
        if (strip && thumbs[i]) {
            const left = thumbs[i].offsetLeft - (strip.clientWidth - thumbs[i].offsetWidth) / 2
            strip.scrollTo({ left, behavior: reduced ? 'auto' : 'smooth' })
        }
    }
    function stop() { if (timer) clearInterval(timer); timer = null }
    function start() {
        stop()
        if (paused) return
        timer = setInterval(() => { i = (i + 1) % shots.length; render() }, 5000)
    }
    /** any manual navigation takes over from the auto-advance for good */
    function pause() { paused = true; stop() }
    function go(n) { i = (n + shots.length) % shots.length; render() }

    window.aiGallery   = d => { pause(); go(i + d) }
    window.aiGalleryGo = n => { pause(); go(n) }

    if (root) {
        root.addEventListener('mouseenter', stop)
        root.addEventListener('mouseleave', start)
        // arrow keys only while the gallery is on screen, so they don't hijack the rest of the page
        if ('IntersectionObserver' in window) {
            visible = false
            new IntersectionObserver(es => { visible = es[0].isIntersecting }, { threshold: 0.35 })
                .observe(root)
        }
        document.addEventListener('keydown', e => {
            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
            if (!visible && document.activeElement !== root && !root.contains(document.activeElement)) return
            const t = e.target
            if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return
            e.preventDefault()
            pause()
            go(i + (e.key === 'ArrowRight' ? 1 : -1))
        })
    }
    render()
    start()
})()
</script>

<!-- ============================================================ WHY SERVICESTACK -->
<section id="key-features" class="bg-white dark:bg-black py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl">Why ServiceStack?</h2>
      <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">Simple, versatile, evolvable, resilient high-performance message-based APIs</p>
    </div>

    <dl class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 text-base leading-7 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      <div>
        <dt class="font-semibold text-gray-900 dark:text-gray-100">Maximize Value and Reach of System APIs</dt>
        <dd class="mt-1 text-gray-600 dark:text-gray-400">
          The same APIs can be consumed from HTTP in a myriad of data formats, via popular MQ Servers
          and over gRPC - without sacrificing any native HTTP integrations.
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-900 dark:text-gray-100">Ultimate Developer Productivity</dt>
        <dd class="mt-1 text-gray-600 dark:text-gray-400">
          Native end-to-end typed integrations for 15 of the most popular languages used to build Web,
          Mobile &amp; Desktop Apps, added and updated from within your favorite IDE.
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-900 dark:text-gray-100">Remote Services Best Practices</dt>
        <dd class="mt-1 text-gray-600 dark:text-gray-400">
          A message-based design embracing the Remote Facade, DTO and Service Gateway patterns - the only
          Services framework to reuse API contracts for typed integrations in .NET Apps without code-gen.
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-900 dark:text-gray-100">Benefits of message-based design</dt>
        <dd class="mt-1 text-gray-600 dark:text-gray-400">
          Unlike RPC, messages can be evolved, intercepted, routed &amp; serialized, letting front and back-end
          developers collaborate on an agreed high-level API design free of implementation concerns.
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-900 dark:text-gray-100">Consistent &amp; Simplified Development Model</dt>
        <dd class="mt-1 text-gray-600 dark:text-gray-400">
          Capturing an entire API boundary into impl-free Service Contracts means every supported language
          need only generate declarative DTOs - encapsulating richer metadata than other code-gen solutions.
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-900 dark:text-gray-100">Preserve Investments</dt>
        <dd class="mt-1 text-gray-600 dark:text-gray-400">
          ServiceStack has promoted the same remote service best-practices for over a decade, outliving
          several abandoned .NET Web Service frameworks and the investments that failed along with them.
        </dd>
      </div>
    </dl>

    <div class="mt-16 flex flex-wrap gap-4">
      <a href="https://docs.servicestack.net/why-servicestack" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-indigo-500 hover:no-underline">Why ServiceStack</a>
      <a href="features" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50 hover:no-underline dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-900">All Features</a>
      <a href="https://docs.servicestack.net" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50 hover:no-underline dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-900">Documentation</a>
    </div>
  </div>
</section>

