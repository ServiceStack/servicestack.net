      <a href="https://docs.servicestack.net/templates/" class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 p-7 transition-all hover:-translate-y-1 hover:border-purple-400 hover:shadow-xl hover:no-underline">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4m8-14l-8 4m0 10L4 17V7m8 10V11M4 7l8 4"/></svg>
        </div>
        <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-gray-100">Project Templates</h3>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Production-ready starting points for React, Vue, Blazor, Angular, Razor Pages, MVC and
          Flutter - each with Identity Auth and AutoQuery pre-configured.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-purple-600 dark:text-purple-400">Browse templates <span aria-hidden="true">&rarr;</span></span>
      </a>

      <a href="https://docs.servicestack.net/pdf" class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 p-7 transition-all hover:-translate-y-1 hover:border-rose-400 hover:shadow-xl hover:no-underline">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.6a1 1 0 01.7.3l4.4 4.4a1 1 0 01.3.7V19a2 2 0 01-2 2z"/></svg>
        </div>
        <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-gray-100">PDF Studio</h3>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Design documents with AI and a live preview, then render them deterministically in
          production from an ordinary ServiceStack API - no LLM in the hot path.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-rose-600 dark:text-rose-400">See PDF Studio <span aria-hidden="true">&rarr;</span></span>
      </a>

    </div>
  </div>
</section>

<script type="module">
import { mount } from "app.mjs"
import DtoDeck from "/mjs/components/DtoDeck.mjs"

/** The docs site's one-contract deck, framed for the home page */
const HomeDtoDeck = {
  components: { DtoDeck },
  template: `<DtoDeck eyebrow="Step through it" description="" />`,
}

mount('#dto-deck', HomeDtoDeck)
</script>

